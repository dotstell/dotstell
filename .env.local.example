# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Corporate / self-signed SSL proxy (development only) ──────────────────────
# Uncomment if you're behind a corporate SSL proxy that intercepts HTTPS.
# DO NOT set this in production — it disables TLS verification entirely.
# NODE_TLS_REJECT_UNAUTHORIZED=0
